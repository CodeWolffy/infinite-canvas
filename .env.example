# 复制为 .env 后替换所有 change-me 值；不要把实际密钥提交到 Git。
POSTGRES_DB=infinite_canvas
POSTGRES_USER=infinite_canvas
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://infinite_canvas:change-me-postgres-password@postgres:5432/infinite_canvas

MINIO_ROOT_USER=infinite_canvas
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=infinite_canvas
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=infinite-canvas

# 至少 32 个字符，用于后续加密数据库中的渠道 API Key；必须单独备份。
CHANNEL_ENCRYPTION_KEY=change-me-at-least-32-characters-long

# 首次启动时创建；同名管理员已存在后不会覆盖密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=管理员

# 标准 Compose 架构通过 Nginx 前置反代 /api/（nginx.conf 附带 X-Forwarded-For 等代理头），
# 开启 TRUST_PROXY=true 可使 API 识别客户端真实 IP，确保访问审计与登录限流生效。
TRUST_PROXY=true
CORS_ORIGIN=http://localhost:3000
# 本地开发 HTTP 环境设为 false；生产环境启用 HTTPS 时必须改为 true，确保会话 Cookie 仅加密传输。
COOKIE_SECURE=false
SESSION_DAYS=7
MAX_UPLOAD_BYTES=52428800
MAX_GENERATED_BYTES=52428800
IMAGE_WORKER_CONCURRENCY=20
# 上游返回的图片地址默认只允许公网主机，防止被引导去下载内网资源；
# 仅当中转网关本身部署在内网、返回的是内网地址时才改成 true。
ALLOW_PRIVATE_IMAGE_HOSTS=false
# 无引用文件自动清理的宽限天数（每天运行一次，仅删除超过该天数且未被任何业务引用的文件）
ORPHAN_MEDIA_GRACE_DAYS=45
# 管理后台请求日志保留天数（每天清理一次，支持 1~365）
REQUEST_LOG_RETENTION_DAYS=30
